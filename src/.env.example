# Copy to src/.env for local development. Never commit real values.
POSTGRES_USER=rundex
POSTGRES_PASSWORD=rundex_dev
POSTGRES_DB=rundex
# Backend (when running outside Docker)
DATABASE_URL=postgresql+psycopg://rundex:rundex_dev@localhost:5432/rundex
# Mobile app (Android emulator reaches the host at 10.0.2.2)
EXPO_PUBLIC_API_URL=http://localhost:8000
